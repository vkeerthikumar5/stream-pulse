# Kafka
KAFKA_BROKER=localhost:9092

# ADSB.lol nearby-aircraft feed
# Defaults to 25 NM around New York City when these values are omitted.
FLIGHT_LATITUDE=40.7128
FLIGHT_LONGITUDE=-74.0060
FLIGHT_RADIUS_NM=25
FLIGHT_POLL_INTERVAL_MS=10000

# OpenSearch
OPENSEARCH_NODE=http://localhost:9200

# SQLite
SQLITE_DB_PATH=./streampulse.db

# S3-compatible archival. Local files are used unless explicitly enabled.
S3_USE_AWS=false
S3_BUCKET_NAME=
AWS_REGION=us-east-1
